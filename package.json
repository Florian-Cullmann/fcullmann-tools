{
  "name": "fcullmann-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postbuild": "mkdir -p .next/standalone/.next/static && cp -R .next/static/. .next/standalone/.next/static/ && if [ -d public ]; then cp -R public .next/standalone/public; fi",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:excel-to-csv": "node scripts/verify-excel-to-csv.mjs",
    "test:pdf-split": "node scripts/verify-pdf-split.mjs",
    "test:word-to-pdf": "node scripts/verify-word-to-pdf.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:watch": "vitest",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@mdgate/doc": "^0.6.25",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-auth": "^4.24.15",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.62.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
